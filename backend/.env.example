# MindCanvas Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI Configuration (required for LLM processing and chat)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
# Any OpenAI-compatible provider works. For DeepSeek:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# Local PostgreSQL (Docker) — no cloud account needed
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mindcanvas

# Application Settings
BACKEND_PORT=8090
FRONTEND_URL=http://localhost:3030
